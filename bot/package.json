{
  "name": "lexicoin-scrabblebot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "sim": "tsx src/sim.ts 200 1",
    "tune": "tsx src/tune.ts 200 7",
    "trace": "tsx src/trace.ts",
    "typecheck": "tsc --noEmit -p .",
    "generate": "spacetime generate --lang typescript --out-dir src/module_bindings --database scrabblebot"
  },
  "dependencies": {
    "spacetimedb": "^2.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
